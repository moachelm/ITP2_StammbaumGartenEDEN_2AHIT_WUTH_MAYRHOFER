@{
    ViewBag.Title = "Stammbaum bearbeiten";
}

<div class="container mt-5">
    <h1>Stammbaum bearbeiten</h1>
    
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    
    <form method="post" class="mt-3">
        <div class="mb-3">
            <label for="firstname" class="form-label">Vorname</label>
            <input type="text" class="form-control" id="firstname" name="firstname" value="@Model?.Firstname" required>
        </div>
        
        <div class="mb-3">
            <label for="lastname" class="form-label">Nachname</label>
            <input type="text" class="form-control" id="lastname" name="lastname" value="@Model?.Lastname" required>
        </div>
        
        <div class="mb-3">
            <label for="birthday" class="form-label">Geburtsdatum (YYYY-MM-DD)</label>
            <input type="text" class="form-control" id="birthday" name="birthday" value="@Model?.Birthday" disabled>
        </div>
        
        <div class="mb-3">
            <label for="deathdate" class="form-label">Sterbedatum (YYYY-MM-DD)</label>
            <input type="text" class="form-control" id="deathdate" name="deathdate" value="@Model?.Deathdate" disabled>
        </div>
        
        <button type="submit" class="btn btn-primary">Speichern</button>
        <a href="@Url.Action("ViewTree", new { id = ViewBag.Id })" class="btn btn-secondary">Abbrechen</a>
    </form>
</div>
